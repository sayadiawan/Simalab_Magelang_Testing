            ],
            toolbar: 'undo redo | bold italic | removeformat | help',
            content_style: 'body { font-family:Helvetica,Arial,sans-serif; font-size:14px }',
            setup: function(editor) {
                editor.on('change blur', function() {
                    tinymce.triggerSave();
                });
            }
        });


